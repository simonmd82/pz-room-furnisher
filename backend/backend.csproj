<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AssemblyName>PzRoomFurnisher</AssemblyName>
    </PropertyGroup>

    <ItemGroup>
      <Folder Include="Data\" />
      <Content Update="Data\**" CopyToPublishDirectory="PreserveNewest" />
      <!-- Backend writes to Data\*.json at runtime (saves, config edits) — must not
           trigger dotnet watch restarts, or the API drops mid-session after every save. -->
      <Watch Remove="Data\**" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.9" />
      <PackageReference Include="Microsoft.OpenApi" Version="2.10.0" />
      <PackageReference Include="Scalar.AspNetCore" Version="2.16.10" />
    </ItemGroup>

</Project>
